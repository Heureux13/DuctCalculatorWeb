@page "/leaktest"
@using DuctCalculatorWeb.Services
@inject PdfExporter Pdf
@using DuctCalculatorWeb.Models
@using System.Text.Json
@inject IJSRuntime JS

<h1>Duct Leakage Test</h1>

<div class="d-flex mb-3">
    <button class="btn btn-outline-secondary" @onclick="() => ExportPdf(false)">Download PDF</button>
    <button class="btn btn-outline-secondary ms-2" @onclick="() => ExportPdf(true)">Email PDF</button>
    <button class="btn btn-outline-danger ms-auto" @onclick="ClearAll">Clear all</button>
</div>

<div class="card mb-4">
    <div class="card-body small">
        <strong>Units</strong>
        <ul class="mb-2">
            <li><strong>SFA</strong> (ft²/ft): surface area per foot of duct, which is the perimeter in feet.</li>
            <li><strong>SFD</strong> (ft²): surface area of the duct, SFA × length.</li>
            <li><strong>TP</strong>, test pressure (in. w.g.): static pressure the duct is tested at.</li>
            <li><strong>AL</strong>, allowable leakage (CFM): the most air the duct may leak at that pressure.</li>
            <li><strong>Leakage class</strong>: seal class A, B, or C. Class C is the tightest.</li>
        </ul>
        <strong>Formulas</strong>
        <ul class="mb-0">
            <li>Round SFA = π × diameter ÷ 12</li>
            <li>Square/rectangular SFA = 2 × (width + height) ÷ 12</li>
            <li>Oval SFA = (2 × (major − minor) + π × minor) ÷ 12</li>
            <li>SFD = SFA × length</li>
            <li>Allowable leakage = class × (SFD ÷ 100) × test pressure<sup>0.65</sup></li>
            <li>Class value: round and oval A/B/C = 2/4/8, square/rectangular A/B/C = 4/8/16</li>
        </ul>
        <p class="text-muted mt-2 mb-0"><em>For reference only. Verify results against the project specifications.</em></p>
    </div>
</div>

<div class="row g-2 mb-4 text-center">
    <div class="col-md-2">
        <label class="form-label fw-bold" for="jobName">Job Name</label>
        <input id="jobName" class="form-control" onfocus="this.dataset.old=this.value;this.value=''" onblur="if(this.value===''){this.value=this.dataset.old}" @bind="_jobName" />
    </div>
    <div class="col-md-2">
        <label class="form-label fw-bold" for="jobNumber">Job #</label>
        <input id="jobNumber" class="form-control" onfocus="this.dataset.old=this.value;this.value=''" onblur="if(this.value===''){this.value=this.dataset.old}" @bind="_jobNumber" />
    </div>
    <div class="col-md-2">
        <label class="form-label fw-bold" for="system">System</label>
        <input id="system" class="form-control" onfocus="this.dataset.old=this.value;this.value=''" onblur="if(this.value===''){this.value=this.dataset.old}" @bind="_system" />
    </div>
    <div class="col-md-2">
        <label class="form-label fw-bold" for="unit">Unit</label>
        <input id="unit" class="form-control" onfocus="this.dataset.old=this.value;this.value=''" onblur="if(this.value===''){this.value=this.dataset.old}" @bind="_unit" />
    </div>
    <div class="col-md-2">
        <label class="form-label fw-bold" for="date">Date</label>
        <input id="date" class="form-control" type="date" @bind="_date" />
    </div>
    <div class="col-md-2">
        <label class="form-label fw-bold" for="witness">Witness</label>
        <input id="witness" class="form-control" onfocus="this.dataset.old=this.value;this.value=''" onblur="if(this.value===''){this.value=this.dataset.old}" @bind="_witness" />
    </div>
</div>

@foreach (var branch in _branches)
{
    <div class="card mb-4 border-orange" @key="branch">
        <div class="card-header d-flex align-items-center gap-3">
            <strong>Branch</strong>
            <input class="form-control w-auto" placeholder="Branch name" onfocus="this.dataset.old=this.value;this.value=''" onblur="if(this.value===''){this.value=this.dataset.old}" @bind="branch.Name" />
            <button class="btn btn-outline-secondary btn-sm" aria-label="Move branch up"
                    @onclick="() => Move(_branches, branch, -1)">▲</button>
            <button class="btn btn-outline-secondary btn-sm" aria-label="Move branch down"
                    @onclick="() => Move(_branches, branch, 1)">▼</button>
            <button class="btn btn-outline-danger btn-sm ms-auto" aria-label="Delete branch"
                    @onclick="() => _branches.Remove(branch)">Delete</button>
        </div>

        <div class="card-body">
            @foreach (var run in branch.Runs)
            {
                <div class="card mb-3 border-primary" @key="run">
                    <div class="card-header d-flex align-items-center gap-3">
                        <strong>Run</strong>
                        <input class="form-control w-auto" placeholder="Run name" onfocus="this.dataset.old=this.value;this.value=''" onblur="if(this.value===''){this.value=this.dataset.old}" @bind="run.Name" />
                        <button class="btn btn-outline-secondary btn-sm" aria-label="Move run up"
                                @onclick="() => Move(branch.Runs, run, -1)">▲</button>
                        <button class="btn btn-outline-secondary btn-sm" aria-label="Move run down"
                                @onclick="() => Move(branch.Runs, run, 1)">▼</button>
                        <button class="btn btn-outline-danger btn-sm ms-auto" aria-label="Delete run"
                                @onclick="() => branch.Runs.Remove(run)">Delete</button>
                    </div>

                    <div class="card-body">
                        @foreach (var sec in run.Sections)
                        {
                            <div class="card mb-3 border-success" @key="sec">
                                <div class="card-header d-flex align-items-center gap-3">
                                    <strong>Section</strong>
                                    <input class="form-control w-auto" placeholder="Section name" onfocus="this.dataset.old=this.value;this.value=''" onblur="if(this.value===''){this.value=this.dataset.old}" @bind="sec.Name" />
                                    <button class="btn btn-outline-secondary btn-sm" aria-label="Move section up"
                                            @onclick="() => Move(run.Sections, sec, -1)">▲</button>
                                    <button class="btn btn-outline-secondary btn-sm" aria-label="Move section down"
                                            @onclick="() => Move(run.Sections, sec, 1)">▼</button>
                                    <button class="btn btn-outline-danger btn-sm ms-auto" aria-label="Delete section"
                                            @onclick="() => run.Sections.Remove(sec)">Delete</button>
                                </div>

                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-bordered table-sm align-middle text-center mb-2 leak-table">
                                            <thead class="table-dark align-top">
                                            <tr>
                                                <th></th>
                                                <th></th>
                                                <th>#</th>
                                                <th>Shape</th>
                                                <th>Diameter<br /><small>(in)</small></th>
                                                <th>Width<br /><small>(in)</small></th>
                                                <th>Height<br /><small>(in)</small></th>
                                                <th>Length<br /><small>(ft)</small></th>
                                                <th>SFA<br /><small>(ft²/ft)</small></th>
                                                <th>SFD<br /><small>(ft²)</small></th>
                                                <th>Class<br /><small>(A/B/C)</small></th>
                                                <th>TP<br /><small>(w.g.)</small></th>
                                                <th>AL<br /><small>(CFM)</small></th>
                                                <th>Running<br />Total</th>
                                                <th></th>
                                            </tr>
                                            </thead>
                                            <tbody>
                                            @for (var i = 0; i < sec.Ducts.Count; i++)
                                            {
                                                var d = sec.Ducts[i];
                                                var running = sec.Ducts.Take(i + 1).Sum(x => x.AllowableLeakage);
                                                var runRunning = running;

                                                <tr @key="d">
                                                    <td class="leak-photo-cell leak-tool">
                                                        @if (d.Photo is null)
                                                        {
                                                            <label class="btn btn-outline-secondary btn-sm py-0 px-1 mb-0" title="Add photo">
                                                                📷
                                                                <InputFile class="d-none" accept="image/*" OnChange="e => AddPhoto(d, e)" />
                                                            </label>
                                                        }
                                                        else
                                                        {
                                                            <img src="@d.Photo" alt="Duct photo" title="View photo" class="leak-thumb"
                                                                 @onclick="() => _viewing = d" />
                                                        }
                                                    </td>
                                                    <td class="text-nowrap leak-tool">
                                                        <button class="btn btn-outline-secondary btn-sm py-0 px-1" aria-label="Move duct up"
                                                                @onclick="() => Move(sec.Ducts, d, -1)">▲</button>
                                                        <button class="btn btn-outline-secondary btn-sm py-0 px-1 ms-2" aria-label="Move duct down"
                                                                @onclick="() => Move(sec.Ducts, d, 1)">▼</button>
                                                    </td>
                                                    <td class="leak-tool leak-num">@(i + 1)</td>
                                                    <td data-label="Shape">
                                                        <select class="form-select form-select-sm leak-narrow" @bind="d.Type">
                                                            <option value="RND">RND</option>
                                                            <option value="SQR">SQR</option>
                                                            <option value="OVL">OVL</option>
                                                        </select>
                                                    </td>
                                                    <td data-label="Diameter (in)"><input class="form-control form-control-sm leak-narrow" type="number" step="any" onfocus="this.dataset.old=this.value;this.value=''" onblur="if(this.value===''){this.value=this.dataset.old}" min="0" max="30" disabled="@(d.Type != "RND")" @bind="d.Diameter" /></td>
                                                    <td data-label="Width (in)"><input class="form-control form-control-sm leak-narrow" type="number" step="any" onfocus="this.dataset.old=this.value;this.value=''" onblur="if(this.value===''){this.value=this.dataset.old}" min="0" max="50" disabled="@(d.Type == "RND")" @bind="d.Width" /></td>
                                                    <td data-label="Height (in)"><input class="form-control form-control-sm leak-narrow" type="number" step="any" onfocus="this.dataset.old=this.value;this.value=''" onblur="if(this.value===''){this.value=this.dataset.old}" min="0" max="50" disabled="@(d.Type == "RND")" @bind="d.Height" /></td>
                                                    <td data-label="Length (ft)"><input class="form-control form-control-sm leak-narrow" type="number" step="any" onfocus="this.dataset.old=this.value;this.value=''" onblur="if(this.value===''){this.value=this.dataset.old}" min="0" max="100" @bind="d.Length" /></td>
                                                    <td data-label="SFA (ft²/ft)">@(d.IsComplete ? d.Sfa.ToString("0.##") : "")</td>
                                                    <td data-label="SFD (ft²)">@(d.IsComplete ? d.Sfd.ToString("0.##") : "")</td>
                                                    <td data-label="Class">
                                                        <select class="form-select form-select-sm" @bind="d.LeakClass">
                                                            <option value="A">A</option>
                                                            <option value="B">B</option>
                                                            <option value="C">C</option>
                                                        </select>
                                                    </td>
                                                    <td data-label="TP (w.g.)"><input class="form-control form-control-sm" type="number" step="any" onfocus="this.dataset.old=this.value;this.value=''" onblur="if(this.value===''){this.value=this.dataset.old}" min="0" max="6" @bind="d.TestPressure" /></td>
                                                    <td data-label="AL (CFM)">@(d.IsComplete ? d.AllowableLeakage.ToString("0.##") : "")</td>
                                                    <td data-label="Running Total">@(d.IsComplete ? runRunning.ToString("0.##") : "")</td>
                                                    <td class="leak-del">
                                                        <button class="btn btn-outline-danger btn-sm" aria-label="Delete duct"
                                                                @onclick="() => sec.Ducts.Remove(d)">✕</button>
                                                    </td>
                                                </tr>
                                            }
                                            </tbody>
                                        </table>
                                    </div>

                                    <button class="btn btn-outline-secondary btn-sm"
                                            @onclick="() => sec.Ducts.Add(new LeakDuct())">+ Add duct</button>
                                </div>
                                <div class="card-footer text-end">Total: @sec.Total.ToString("0.##") CFM</div>
                            </div>
                        }

                        <button class="                        btn btn-outline-success btn-sm"
                                @onclick="() => run.Sections.Add(new LeakSection { Name = NextName(run.Sections.Select(s => s.Name), 'S') })">+ Add section</button>
                    </div>
                    <div class="card-footer text-end">Total: @run.Total.ToString("0.##") CFM</div>
                </div>
            }

            <button class="            btn btn-outline-primary btn-sm"
                    @onclick="() => branch.Runs.Add(new LeakRun { Name = NextName(branch.Runs.Select(r => r.Name), 'R') })">+ Add run</button>
        </div>
        <div class="card-footer text-end">Total: @branch.Total.ToString("0.##") CFM</div>
    </div>
}

<button class="btn btn-outline-orange mb-4"
        @onclick="() => _branches.Add(new LeakBranch { Name = NextName(_branches.Select(b => b.Name), 'B') })">+ Add branch</button>

@if (_storageFull)
{
    <div class="alert alert-warning">Storage is full, so recent changes aren't saved. Remove some photos to free up space.</div>
}

@if (_viewing is { Photo: not null } viewing)
{
    <div class="leak-photo-overlay" @onclick="() => _viewing = null">
        <div class="leak-photo-box" @onclick:stopPropagation="true">
            <img src="@viewing.Photo" alt="Duct photo" />
            <div class="d-flex gap-2 mt-2">
                <label class="btn btn-outline-secondary mb-0">
                    Retake / replace
                    <InputFile class="d-none" accept="image/*" OnChange="e => AddPhoto(viewing, e)" />
                </label>
                <button class="btn btn-outline-danger"
                        @onclick="() => { viewing.Photo = null; _viewing = null; }">Remove photo</button>
                <button class="btn btn-secondary ms-auto" @onclick="() => _viewing = null">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private string _jobName = "";
    private string _jobNumber = "";
    private string _system = "";
    private string _unit = "";
    private DateTime? _date;
    private string _witness = "";
    private List<LeakBranch> _branches = new() { new LeakBranch() };

    // Picks the next unused number, e.g. R01, R02 -> R03 (skips names the user typed).
    private static string NextName(IEnumerable<string> existing, char letter)
    {
        var used = existing.ToHashSet(StringComparer.OrdinalIgnoreCase);
        var n = 1;
        while (used.Contains($"{letter}{n:00}"))
        {
            n++;
        }
        return $"{letter}{n:00}";
    }
    private const string StorageKey = "leaktest-v1";
    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
            var save = json is null ? null : JsonSerializer.Deserialize<LeakSave>(json);

            if (save is not null)
            {
                _jobName = save.JobName;
                _jobNumber = save.JobNumber;
                _system = save.System;
                _unit = save.Unit;
                _date = save.Date;
                _witness = save.Witness;
                _branches = save.Branches;
            }
        }
        catch (Exception)
        {
            // Corrupt or unavailable storage: start with a blank form.
        }

        FillNames();
        _loaded = true;
    }

    // Gives any blank branch, run, or section a default name like B01, R01, S01.
    private void FillNames()
    {
        foreach (var branch in _branches.Where(b => string.IsNullOrWhiteSpace(b.Name)))
        {
            branch.Name = NextName(_branches.Select(b => b.Name), 'B');
        }

        foreach (var branch in _branches)
        {
            foreach (var run in branch.Runs.Where(r => string.IsNullOrWhiteSpace(r.Name)))
            {
                run.Name = NextName(branch.Runs.Select(r => r.Name), 'R');
            }

            foreach (var run in branch.Runs)
            {
                foreach (var sec in run.Sections.Where(s => string.IsNullOrWhiteSpace(s.Name)))
                {
                    sec.Name = NextName(run.Sections.Select(s => s.Name), 'S');
                }
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_loaded)
        {
            return;
        }

        var save = new LeakSave
        {
            JobName = _jobName, JobNumber = _jobNumber, System = _system,
            Unit = _unit, Date = _date, Witness = _witness, Branches = _branches
        };

        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, JsonSerializer.Serialize(save));
            _storageFull = false;
        }
        catch (JSException)
        {
            // Browser storage is full (usually too many photos).
            if (!_storageFull)
            {
                _storageFull = true;
                StateHasChanged();
            }
        }
    }

    private LeakDuct? _viewing;
    private bool _storageFull;

    private async Task AddPhoto(LeakDuct duct, InputFileChangeEventArgs e)
    {
        // Shrink in the browser first so photos fit in local storage.
        var image = await e.File.RequestImageFileAsync("image/jpeg", 1024, 1024);
        await using var stream = image.OpenReadStream(10_000_000);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);
        duct.Photo = "data:image/jpeg;base64," + Convert.ToBase64String(memory.ToArray());
    }

    private async Task ClearAll()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Clear all data on this page? This can't be undone."))
        {
            return;
        }

        _jobName = _jobNumber = _system = _unit = _witness = "";
        _date = null;
        _branches = new() { new LeakBranch() };
    }

    private static void Move<T>(List<T> list, T item, int direction)
    {
        var index = list.IndexOf(item);
        var target = index + direction;

        if (index < 0 || target < 0 || target >= list.Count)
        {
            return;
        }

        list.RemoveAt(index);
        list.Insert(target, item);
    }
    
    private async Task ExportPdf(bool email)
    {
        FillNames();
        var head = new[]
        {
            "#", "Shape", "Diameter\n(in)", "Width\n(in)",
            "Height\n(in)", "Length\n(ft)", "SFA\n(ft²/ft)", "SFD\n(ft²)",
            "Class\n(A/B/C)", "TP\n(w.g.)", "AL\n(CFM)",
            "Running\nTotal"
        };

        var subtitle =
            $"Job Name: {_jobName}|Job #: {_jobNumber}|System: {_system}|" +
            $"Unit: {_unit}|Date: {(_date is null ? "" : _date.Value.ToString("MM/dd/yyyy"))}|Witness: {_witness}";

        var legend = new[]
        {
            "#Units",
            "SFA (ft²/ft): surface area per foot of duct, which is the perimeter in feet.",
            "SFD (ft²): surface area of the duct, SFA × length.",
            "TP, test pressure (in. w.g.): static pressure the duct is tested at.",
            "AL, allowable leakage (CFM): the most air the duct may leak at that pressure.",
            "Leakage class: seal class A, B, or C. Class C is the tightest.",
            
            "#Formulas",
            "Round SFA = pi × diameter ÷ 12;  Square/rectangular SFA = 2 × (width + height) ÷ 12;  Oval SFA = (2 × (major - minor) + pi × minor) ÷ 12",
            "SFD = SFA × length;  Allowable leakage = class × (SFD ÷ 100) × test pressure^0.65",
            "Class value: round and oval A/B/C = 2/4/8, square/rectangular A/B/C = 4/8/16",
            
            "For reference only. Verify results against the project specifications."
        };

        var boxes = _branches.Select(branch => new PdfBranchBox(
            branch.Name,
            branch.Total,
            branch.Runs.Select(run => new PdfRunBox(
                run.Name,
                run.Total,
                run.Sections.Select(sec =>
                {
                    var rows = sec.Ducts.Select((d, i) =>
                    {
                        var running = sec.Ducts.Take(i + 1).Sum(x => x.AllowableLeakage);

                        return new[]
                        {
                            (i + 1).ToString(),
                            d.Type,
                            d.Type == "RND" ? $"{d.Diameter:0.##}" : "",
                            d.Type == "RND" ? "" : $"{d.Width:0.##}",
                            d.Type == "RND" ? "" : $"{d.Height:0.##}",
                            $"{d.Length:0.##}",
                            d.IsComplete ? $"{d.Sfa:0.##}" : "",
                            d.IsComplete ? $"{d.Sfd:0.##}" : "",
                            d.LeakClass,
                            $"{d.TestPressure:0.##}",
                            d.IsComplete ? $"{d.AllowableLeakage:0.##}" : "",
                            d.IsComplete ? $"{running:0.##}" : ""
                        };
                    }).ToArray();

                    return new PdfSectionBox(sec.Name, sec.Total, rows);
                }).ToArray())).ToArray())).ToArray();

        var photos = (
            from b in _branches
            from r in b.Runs
            from s in r.Sections
            from d in s.Ducts.Select((duct, i) => (duct, i))
            where d.duct.Photo is not null
            select new PdfPhoto($"{b.Name} / {r.Name} / {s.Name} / #{d.i + 1}", d.duct.Photo!)
        ).ToArray();

        await Pdf.ExportNested("Nava's Leakage Test Extravaganza Where Air Don't Care", subtitle, head, boxes, "leak-test.pdf", legend, photos, email);
    }
}
